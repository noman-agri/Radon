# Radon 1 - non-secret config (safe to share). Keys are NOT here: they live in ~/.radon/secrets.env.
# Format: provider:model, comma separated = fallback order (extract) / swarm members (review).
# Mixing providers makes the swarm stronger (independent mistakes). Re-check: python scripts/free_llm.py ping
# Verified 2026-11-25. Members without a saved key are skipped automatically.
RADON_SCOUT_PROVIDER=openrouter
RADON_SCOUT_MODEL=gemini:gemini-3.5-flash,openrouter:baidu/ernie-5.5-flash-preview:free,openrouter:recursive/flint-v1.0:free,gemini:gemini-flash-latest,openrouter:inclusionai/ling-3.2-flash:free,gemini:gemini-3.1-flash-lite
RADON_SCOUT_REVIEW_MODEL=gemini:gemini-3.5-flash,openrouter:baidu/ernie-5.5-flash-preview:free,openrouter:recursive/flint-v1.0:free,gemini:gemini-3.8-flash,openrouter:inclusionai/ling-3.2-flash:free,gemini:gemini-flash-latest
# Trust tiers: these providers may see real code, documents and images (secrets still redacted).
# Every other provider (openrouter, xai, ...) only sees MASKED code and never documents or images.
RADON_TRUSTED_PROVIDERS=gemini,ollama
# Image -> text (saves Claude's image tokens). Trusted providers only.
RADON_VISION_MODEL=gemini:gemini-3.5-flash,gemini:gemini-flash-latest,gemini:gemini-3.8-flash
